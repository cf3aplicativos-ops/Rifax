model roles {
  id             BigInt           @id @default(autoincrement())
  nombre         String           @unique
  descripcion    String?
  roles_permisos roles_permisos[]
  usuarios       usuarios[]

  @@schema("saas")
}

model roles_permisos {
  rol_id     BigInt
  permiso_id BigInt
  permisos   permisos @relation(fields: [permiso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles      roles    @relation(fields: [rol_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([rol_id, permiso_id])
  @@index([permiso_id], map: "idx_roles_permisos_permiso")
  @@schema("saas")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
