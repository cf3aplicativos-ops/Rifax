  direccion                                                        String?
  telefono                                                         String?
  estado                                                           String               @default("activa")
  creado_en                                                        DateTime             @default(now()) @db.Timestamptz(6)
  boletas_boletas_sede_idTosedes                                   boletas[]            @relation("boletas_sede_idTosedes")
  boletas_boletas_sede_id_tenant_idTosedes                         boletas[]            @relation("boletas_sede_id_tenant_idTosedes")
  rifas_rifas_sede_id_tenant_idTosedes                             rifas[]              @relation("rifas_sede_id_tenant_idTosedes")
