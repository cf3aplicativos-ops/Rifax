# ============ BASE DE DATOS (Neon) ============
# Producción: usa la cadena POOLED de Neon (incluye -pooler y sslmode=require)
DATABASE_URL=postgres://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/rifax?sslmode=require
# En serverless conviene un pool pequeño (PgBouncer de Neon hace el resto)
DB_POOL_MAX=3

# ============ AUTENTICACIÓN ============
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_TTL=900

# ============ SERVIDOR (solo local; en Vercel no se usa) ============
PORT=6070

# ============ GROQ (IA) ============
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_AUDIO=whisper-large-v3

# ============ SEED ADMIN ============
ADMIN_EMAIL=admin@rifax.co
ADMIN_PASSWORD=Admin12345!
